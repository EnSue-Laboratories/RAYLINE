{
  "name": "ensue",
  "productName": "RayLine",
  "description": "RayLine \u2014 a desktop client for Claude Code",
  "author": {
    "name": "Ensue Laboratories",
    "email": "contact@ensue.dev"
  },
  "homepage": "https://github.com/EnSue-Laboratories/RAYLINE",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "main": "dist-electron/electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite --port 5199 --strictPort\" \"node scripts/build-electron.mjs --watch\" \"wait-on http://localhost:5199 dist-electron/electron/main.cjs && node scripts/dev-electron.cjs 5199\"",
    "typecheck": "tsc -p tsconfig.renderer.json && tsc -p tsconfig.electron.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "build:electron": "npm run build && electron-builder --config electron-builder.config.cjs",
    "build:electron:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac",
    "build:electron:win": "npm run build && electron-builder --config electron-builder.config.cjs --win --config.npmRebuild=false",
    "lint": "eslint .",
    "lint:ts": "node scripts/ts-migration.ts lint",
    "verify:theme-tokens": "node scripts/verify-theme-tokens.mjs",
    "preview": "vite preview",
    "rebuild": "electron-rebuild -f -w node-pty",
    "ts:progress": "node scripts/ts-migration.ts report"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/addon-fit": "^0.12.0-beta.199",
    "@xterm/xterm": "^6.1.0-beta.199",
    "electron-updater": "^6.8.3",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.45",
    "lucide-react": "^1.8.0",
    "mermaid": "^11.14.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "uuid": "^13.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.4",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.4",
    "vitest": "^5.0.3",
    "wait-on": "^9.0.5"
  }
}
